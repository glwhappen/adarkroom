# 数据库：自建 Supabase 的 supabase-db 容器，注意端口是 54322 不是 5432
DATABASE_URL=postgres://postgres:改成密码@supabase-db:54322/postgres

# Authentik OIDC（在 Authentik 新建 Provider + Application，slug 建议 adarkroom）
AUTHENTIK_ISSUER=https://auth.hsfp.cn/application/o/campfire/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://campfire.hsfp.cn/auth/callback

# 会话签名密钥：openssl rand -hex 32
SESSION_SECRET=

# 可选
PORT=4401
SESSION_TTL_SEC=2592000
COOKIE_SECURE=true
